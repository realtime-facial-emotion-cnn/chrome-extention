{
  "manifest_version": 3,
  "name": "Meeting Insight Recorder",
  "version": "1.0",
  "description": "Record meeting audio and video for AI-powered insights",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Meeting Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/recorder.html",
        "popup/recorder.js",
        "popup/popup.css",
        "popup/summary.html",
        "popup/summary.css",
        "popup/summary.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}